rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// WorldCrown48 — Firestore Security Rules
//
// Collections covered:
//   /tournaments/{id}      — public read of `featured == true` docs only
//   /waitlist/{id}         — create-only; doc ID MUST be SHA-256(email)
//   /cookieConsents/{uid}  — owner-only read/write; uid is the doc id
//   /votes/{voteId}        — owner-only read; write blocked (callable only)
//   /auditLog/{logId}      — read/write blocked (admin SDK only)
//   /userPrefs/{uid}       — owner-only read/write, schema-validated
//
// All other paths are denied by default.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── tournaments ────────────────────────────────────────────────
    // Public reads are restricted to docs with featured == true.
    //
    // How `read` interacts with queries:
    //   - `get` (single doc): the rule evaluates against that doc.
    //     Non-featured docs return permission-denied to direct fetchers.
    //   - `list` (collection query): the rule evaluates per returned
    //     doc. A query without `where("featured", "==", true)` would
    //     return non-featured docs → entire query fails. The Launch Pad
    //     client query (`where featured==true limit 1`) returns only
    //     featured docs → passes per-doc → succeeds.
    //
    // B-1 The Lab makes this collection writable by its operator (owner).
    //   read   — public reads stay featured-only (Launch Pad hero); the
    //            operator additionally reads their own Tournaments
    //            (TournamentList query: where hostUid == uid).
    //   create — MVP1 has no custom claims, so operator-only is enforced
    //            client-side (AdminAuthGuard). Rules enforce owner-scoping:
    //            you may only create a Tournament you host.
    //   update/delete — owner only.
    match /tournaments/{tournamentId} {
      // C-1: Voters read ACTIVE tournaments to vote (active-public). Launch Pad
      // still relies on featured-public; the operator reads their own.
      allow read: if resource.data.status == 'active'
                  || resource.data.featured == true
                  || (request.auth != null
                      && resource.data.hostUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // ── contestants (B-1) ──────────────────────────────────────────
    // New collection. hostUid is denormalized from the parent Tournament so
    // create rules are BATCH-SAFE: Publish writes the Tournament + 48
    // Contestants in one writeBatch, and rules get() can't see a same-batch
    // doc — so we validate hostUid on the Contestant itself instead of a
    // get() to the (not-yet-committed) Tournament. No PII on these docs;
    // reads are owner-scoped for now and C-1 will relax them to public when
    // Voters need to read Contestants for voting.
    match /contestants/{contestantId} {
      // C-1: public read — Contestants carry no PII and Voters must read them to
      // vote. Writes stay operator-owner-scoped.
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // ── waitlist ───────────────────────────────────────────────────
    // Create-only. No read, no update, no delete from clients.
    //
    // Duplicate detection works because:
    //   - The client computes SHA-256(email) and uses it as the doc ID.
    //   - `setDoc(doc("waitlist", hash), …)` on an existing doc is
    //     evaluated as an update — denied here → permission-denied.
    //   - On a new ID, it's a create → allowed (subject to schema check
    //     below). One email = exactly one document. Emails never leave
    //     the database via reads.
    //
    // Schema:
    //   email      — string, basic shape & length check
    //   createdAt  — must equal request.time (serverTimestamp)
    //   (only those two keys; reject extra fields)
    match /waitlist/{docId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 320
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.createdAt == request.time
        // docId must be exactly 64 lowercase hex chars (SHA-256).
        && docId.matches('^[0-9a-f]{64}$');
    }

    // ── cookieConsents ─────────────────────────────────────────────
    // Each user owns the doc at /cookieConsents/{their-uid}. No one else
    // can read or write it — the consent record is legally sensitive PII
    // (it ties an IP hash to a category set).
    //
    // Anonymous Auth IS valid for ownership here: handoff §9 trap 9 calls
    // for `signInAnonymously()` before consent so the visitor has a stable
    // uid even pre-signup. That uid is treated the same as a logged-in uid
    // for the purposes of this rule.
    //
    // Schema validation on write (handoff §B):
    //   essential   — must be true (constant)
    //   functional  — bool
    //   analytics   — bool
    //   marketing   — bool
    //   timestamp   — server time at write (`request.time`)
    //   expiresAt   — Timestamp ~12 months ahead (lower bound check only;
    //                  client clock skew makes exact equality fragile)
    //   ipHash      — string (may be empty when the hashIp callable fails)
    //   lang        — 'ko' | 'en'
    //   version     — string (policy version at consent time)
    match /cookieConsents/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Both create and update share the same schema check.
      allow write: if
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.essential == true
        && request.resource.data.functional is bool
        && request.resource.data.analytics is bool
        && request.resource.data.marketing is bool
        && request.resource.data.timestamp == request.time
        && request.resource.data.expiresAt is timestamp
        // Lower-bound on expiresAt: must be at least 300 days in the future.
        // (The client computes savedAt + 365d; allowing 65d of skew tolerance.)
        && request.resource.data.expiresAt > request.time + duration.value(300, 'd')
        && request.resource.data.ipHash is string
        && request.resource.data.ipHash.size() <= 64
        && (request.resource.data.lang == 'ko' || request.resource.data.lang == 'en')
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 16
        && request.resource.data.keys().hasOnly([
             'uid', 'essential', 'functional', 'analytics', 'marketing',
             'timestamp', 'expiresAt', 'ipHash', 'lang', 'version'
           ]);
    }

    // ── votes ──────────────────────────────────────────────────────
    // Read: only the vote's owner can list/get their own vote rows. This
    // is what useVoteGate.getTodayVoteCount() runs as the signed-in user.
    // Write: blocked — vote rows are only written by Cloud Functions
    // (onVote, linkSessionVote) running with admin credentials.
    match /votes/{voteId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── roundProgress (C-1) ────────────────────────────────────────
    // Per-Voter round-transition + Champion doc (id = `${uid}_${tid}`), the
    // client subscribes via onSnapshot (ADR-0001, Firestore-only). Read: owner
    // only. Write: blocked — only advanceRound (admin SDK) writes it, so a
    // Voter can never forge a round advance or a Champion.
    match /roundProgress/{progressId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── crown_cards (C-2) ──────────────────────────────────────────
    // Per-Voter Crown Card metadata (id = `${voterUid}_${tournamentId}`),
    // written ONLY by onChampionConfirmed (admin SDK). A Voter reads their own
    // card; `featured == true` cards are public for the MVP-2 Hall of Fame.
    // Client writes are blocked so a Voter can never forge a Champion card.
    match /crown_cards/{cardId} {
      allow read: if request.auth != null
                  && (resource.data.voterUid == request.auth.uid
                      || resource.data.featured == true);
      allow write: if false;
    }

    // ── auditLog ───────────────────────────────────────────────────
    // GDPR Art. 30 record. Both read and write are blocked at the rules
    // layer; the only writer is onUserDelete (admin SDK), and reads
    // happen via console / future Admin Dashboard with its own auth.
    // Critically: client must NEVER see uidHash → uid mappings.
    match /auditLog/{logId} {
      allow read, write: if false;
    }

    // ── userPrefs ──────────────────────────────────────────────────
    // Owner-only. Schema validation keeps the doc small + types tight:
    //   uid       — must equal the doc id and the caller's uid
    //   lang      — 'ko' | 'en'
    //   theme     — optional: 'auto' | 'dark' | 'light'
    //   updatedAt — server time at write
    match /userPrefs/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow write: if
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (request.resource.data.lang == 'ko' || request.resource.data.lang == 'en')
        && (
          !('theme' in request.resource.data.keys())
          || request.resource.data.theme == 'auto'
          || request.resource.data.theme == 'dark'
          || request.resource.data.theme == 'light'
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
             'uid', 'lang', 'theme', 'updatedAt'
           ]);
    }

    // ── default deny ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
