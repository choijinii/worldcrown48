rules_version = '2';

// ════════════════════════════════════════════════════════════════════
// WorldCrown48 — Firestore Security Rules
//
// Collections covered:
//   /tournaments/{id}      — public read of `featured == true` docs only
//   /waitlist/{id}         — create-only; doc ID MUST be SHA-256(email)
//   /cookieConsents/{uid}  — owner-only read/write; uid is the doc id
//   /votes/{voteId}        — owner-only read; write blocked (callable only)
//   /ranking_cache/{id}    — read gated by Tournament Deadline (W-7); write blocked
//   /admin_alerts/{id}     — admin-claim read/write only (anomaly flags)
//   /auditLog/{logId}      — read/write blocked (admin SDK only)
//   /userPrefs/{uid}       — owner-only read/write, schema-validated
//
// All other paths are denied by default.
// ════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── tournaments ────────────────────────────────────────────────
    // Public reads are restricted to docs with featured == true.
    //
    // How `read` interacts with queries:
    //   - `get` (single doc): the rule evaluates against that doc.
    //     Non-featured docs return permission-denied to direct fetchers.
    //   - `list` (collection query): the rule evaluates per returned
    //     doc. A query without `where("featured", "==", true)` would
    //     return non-featured docs → entire query fails. The Launch Pad
    //     client query (`where featured==true limit 1`) returns only
    //     featured docs → passes per-doc → succeeds.
    //
    // B-1 The Lab makes this collection writable by its operator (owner).
    //   read   — public reads stay featured-only (Launch Pad hero); the
    //            operator additionally reads their own Tournaments
    //            (TournamentList query: where hostUid == uid).
    //   create — MVP1 has no custom claims, so operator-only is enforced
    //            client-side (AdminAuthGuard). Rules enforce owner-scoping:
    //            you may only create a Tournament you host.
    //   update/delete — owner only.
    match /tournaments/{tournamentId} {
      // C-1: Voters read ACTIVE tournaments to vote (active-public). Launch Pad
      // still relies on featured-public; the operator reads their own.
      allow read: if resource.data.status == 'active'
                  || resource.data.featured == true
                  || (request.auth != null
                      && resource.data.hostUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // ── contestants (B-1) ──────────────────────────────────────────
    // New collection. hostUid is denormalized from the parent Tournament so
    // create rules are BATCH-SAFE: Publish writes the Tournament + 48
    // Contestants in one writeBatch, and rules get() can't see a same-batch
    // doc — so we validate hostUid on the Contestant itself instead of a
    // get() to the (not-yet-committed) Tournament. No PII on these docs;
    // reads are owner-scoped for now and C-1 will relax them to public when
    // Voters need to read Contestants for voting.
    match /contestants/{contestantId} {
      // C-1: public read — Contestants carry no PII and Voters must read them to
      // vote. Writes stay operator-owner-scoped.
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // ── waitlist ───────────────────────────────────────────────────
    // Create-only. No read, no update, no delete from clients.
    //
    // Duplicate detection works because:
    //   - The client computes SHA-256(email) and uses it as the doc ID.
    //   - `setDoc(doc("waitlist", hash), …)` on an existing doc is
    //     evaluated as an update — denied here → permission-denied.
    //   - On a new ID, it's a create → allowed (subject to schema check
    //     below). One email = exactly one document. Emails never leave
    //     the database via reads.
    //
    // Schema:
    //   email      — string, basic shape & length check
    //   createdAt  — must equal request.time (serverTimestamp)
    //   (only those two keys; reject extra fields)
    match /waitlist/{docId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 320
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.createdAt == request.time
        // docId must be exactly 64 lowercase hex chars (SHA-256).
        && docId.matches('^[0-9a-f]{64}$');
    }

    // ── cookieConsents ─────────────────────────────────────────────
    // Each user owns the doc at /cookieConsents/{their-uid}. No one else
    // can read or write it — the consent record is legally sensitive PII
    // (it ties an IP hash to a category set).
    //
    // Anonymous Auth IS valid for ownership here: handoff §9 trap 9 calls
    // for `signInAnonymously()` before consent so the visitor has a stable
    // uid even pre-signup. That uid is treated the same as a logged-in uid
    // for the purposes of this rule.
    //
    // Schema validation on write (handoff §B):
    //   essential   — must be true (constant)
    //   functional  — bool
    //   analytics   — bool
    //   marketing   — bool
    //   timestamp   — server time at write (`request.time`)
    //   expiresAt   — Timestamp ~12 months ahead (lower bound check only;
    //                  client clock skew makes exact equality fragile)
    //   ipHash      — string (may be empty when the hashIp callable fails)
    //   lang        — 'ko' | 'en'
    //   version     — string (policy version at consent time)
    match /cookieConsents/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Both create and update share the same schema check.
      allow write: if
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.essential == true
        && request.resource.data.functional is bool
        && request.resource.data.analytics is bool
        && request.resource.data.marketing is bool
        && request.resource.data.timestamp == request.time
        && request.resource.data.expiresAt is timestamp
        // Lower-bound on expiresAt: must be at least 300 days in the future.
        // (The client computes savedAt + 365d; allowing 65d of skew tolerance.)
        && request.resource.data.expiresAt > request.time + duration.value(300, 'd')
        && request.resource.data.ipHash is string
        && request.resource.data.ipHash.size() <= 64
        && (request.resource.data.lang == 'ko' || request.resource.data.lang == 'en')
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 16
        && request.resource.data.keys().hasOnly([
             'uid', 'essential', 'functional', 'analytics', 'marketing',
             'timestamp', 'expiresAt', 'ipHash', 'lang', 'version'
           ]);
    }

    // ── votes ──────────────────────────────────────────────────────
    // Read: only the vote's owner can list/get their own vote rows.
    // Write: blocked — vote rows are only written by Cloud Functions
    // (onVote, linkSessionVote) running with admin credentials.
    match /votes/{voteId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── daily_participation (HF-1) ─────────────────────────────────
    // One doc per Voter per KST day (id = `${uid}_${YYYY-MM-DD}`) holding the
    // set of Tournaments the Voter has JOINED today. useVoteGate reads its own
    // doc (single get) to enforce the Daily Participation Limit (5 new
    // Tournaments / KST day). Firebase uids are alphanumeric with no '_', so
    // `split('_')[0]` recovers the owner uid from the doc id. Write: blocked —
    // only onVote (admin SDK) mutates it, atomically inside the vote tx, so a
    // Voter can never forge or reset their participation set.
    match /daily_participation/{docId} {
      allow read: if request.auth != null
                  && docId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // ── roundProgress (C-1) ────────────────────────────────────────
    // Per-Voter round-transition + Champion doc (id = `${uid}_${tid}`), the
    // client subscribes via onSnapshot (ADR-0001, Firestore-only). Write:
    // blocked — only advanceRound (admin SDK) writes it, so a Voter can never
    // forge a round advance or a Champion.
    //
    // Read: owner only, keyed off the DOC ID — not resource.data. HF-1.6: a
    // Voter entering a new Tournament subscribes BEFORE advanceRound creates
    // the doc; a `resource.data.userId == uid` rule denies the get/listen on
    // the not-yet-existing doc, which kills useRoundTransition's onSnapshot
    // (no overlay; THE FINAL hangs until refresh). The doc-id prefix check
    // (id = `${uid}_${tid}`; Firebase uids carry no '_') authorizes the owner
    // whether or not the doc exists, and leaks no other Voter's doc existence.
    match /roundProgress/{progressId} {
      allow read: if request.auth != null
                  && progressId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // ── crown_cards (C-2) ──────────────────────────────────────────
    // Per-Voter Crown Card metadata (id = `${voterUid}_${tournamentId}`),
    // written ONLY by onChampionConfirmed (admin SDK). A Voter reads their own
    // card; `featured == true` cards are public for the MVP-2 Hall of Fame.
    // Client writes are blocked so a Voter can never forge a Champion card.
    //
    // Read: owner keyed off the DOC ID (id = `${voterUid}_${tid}`; uids carry
    // no '_'), so the owner may get/listen BEFORE onChampionConfirmed creates
    // the doc — same not-yet-existing-doc trap as roundProgress (HF-1.6). The
    // `featured` public branch still reads resource.data, so it's guarded by
    // `resource != null` to avoid denying on a missing doc.
    match /crown_cards/{cardId} {
      allow read: if request.auth != null
                  && (cardId.split('_')[0] == request.auth.uid
                      || (resource != null
                          && resource.data.featured == true));
      allow write: if false;
    }

    // ── bracket_seeds (HF-2) ───────────────────────────────────────
    // Per-Voter, per-Tournament random bracket seed (id = `${uid}_${tid}`),
    // the third input to the pure bracket (contestants, votes, seed) — ADR-0007.
    // Created ONCE on Arena entry, then immutable (a changed seed would reshuffle
    // an in-flight bracket → duplicate winners → broken round transition).
    //
    // Read: owner keyed off the DOC ID — NOT resource.data. HF-1.6 (PR #37): the
    // Voter get/listens this doc on Arena entry BEFORE it is created; a
    // `resource.data.uid == uid` rule would permission-deny that read on the
    // not-yet-existing doc and kill the listener. The doc-id prefix authorizes
    // the owner whether or not the doc exists (Firebase uids carry no '_').
    //
    // Create-once: `create` fires only on a non-existent doc; `update`/`delete`
    // are blocked, so the seed can be written exactly once and never mutated.
    // The client's load-or-create relies on this (bracketSeed.ts); a two-tab
    // race has its losing create rejected here and re-reads the winner's seed.
    match /bracket_seeds/{seedId} {
      allow read: if request.auth != null
                  && seedId.split('_')[0] == request.auth.uid;
      allow create: if request.auth != null
                    && seedId.split('_')[0] == request.auth.uid
                    && request.resource.data.keys().hasOnly(['seed', 'createdAt'])
                    && request.resource.data.seed is int
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── ranking_cache (C-3 The Arena) ──────────────────────────────
    // The ONLY Vote Rate (%) surface. Read is gated by the Tournament Deadline
    // (W-7, defense in depth): a ranking exposed before close skews 표심, so the
    // cache only becomes readable once `tournamentDeadline < request.time`. Writes
    // are blocked — the sole writer is scheduleRankingCache (admin SDK bypasses
    // rules). `voteCount` rides inside the doc (internal only) — the UI is
    // forbidden from rendering it (CLAUDE.md 원칙 #8), but rules can't field-mask,
    // so the no-Vote-Count guard lives in the client + E2E (trap #7), not here.
    match /ranking_cache/{tournamentId} {
      allow read: if exists(/databases/$(database)/documents/tournaments/$(tournamentId))
                  && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.tournamentDeadline < request.time;
      allow write: if false;

      // 24-generation history (T-3 24h baseline) — same Deadline gate + posture.
      match /history/{generationSequence} {
        allow read: if exists(/databases/$(database)/documents/tournaments/$(tournamentId))
                    && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.tournamentDeadline < request.time;
        allow write: if false;
      }
    }

    // ── admin_alerts (C-3 anomaly flags) ───────────────────────────
    // Anomaly records (T-1..T-4) written by scheduleRankingCache (admin SDK).
    // Read/write require the `admin` custom claim — a Voter must NEVER see them
    // (they expose the internal anomaly model + would let a forged write spoof
    // alerts). The Admin Dashboard (G-1) reads them with its own auth.
    match /admin_alerts/{alertId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── auditLog ───────────────────────────────────────────────────
    // GDPR Art. 30 record. Both read and write are blocked at the rules
    // layer; the only writer is onUserDelete (admin SDK), and reads
    // happen via console / future Admin Dashboard with its own auth.
    // Critically: client must NEVER see uidHash → uid mappings.
    match /auditLog/{logId} {
      allow read, write: if false;
    }

    // ── userPrefs ──────────────────────────────────────────────────
    // Owner-only. Schema validation keeps the doc small + types tight:
    //   uid       — must equal the doc id and the caller's uid
    //   lang      — 'ko' | 'en'
    //   theme     — optional: 'auto' | 'dark' | 'light'
    //   updatedAt — server time at write
    match /userPrefs/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow write: if
        request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && (request.resource.data.lang == 'ko' || request.resource.data.lang == 'en')
        && (
          !('theme' in request.resource.data.keys())
          || request.resource.data.theme == 'auto'
          || request.resource.data.theme == 'dark'
          || request.resource.data.theme == 'light'
        )
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
             'uid', 'lang', 'theme', 'updatedAt'
           ]);
    }

    // ── categories (TX-0 Category Taxonomy) ────────────────────────
    // Public reference data: every client reads the whole collection once on
    // page load (loadCategories) to drive the Lab dropdown and (later) the
    // Pitch/Arena category nav. The docs carry no PII (id + locale names +
    // status/phase/order), so read is fully public — including pre-auth Pitch.
    //
    // Write requires the `admin` custom claim: the taxonomy is operated via the
    // seed/migration scripts (admin SDK, bypasses rules) or a future admin UI. A
    // Voter must NEVER add, hide, or reorder a category (it would reshape
    // discovery for everyone), so every client write is denied here.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── news (ND-1 News Desk) ──────────────────────────────────────
    // 승인제 뉴스 팩토리. Public reads ONLY published articles (AC 5): a draft or
    // archived doc must never be visible on /news, /news/[slug], or NewsRail. An
    // operator holding the `admin` custom claim reads ANY status (초안 대기함).
    //
    // Write requires the admin claim — the console publishes/edits/내리기 directly
    // (client), and the generateNewsDraft callable + triggers + cron write via the
    // admin SDK (bypasses rules). A Voter must NEVER create or publish an article.
    match /news/{slug} {
      allow read: if resource.data.status == 'published'
                  || (request.auth != null && request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // ── news_generation (ND-1 rate-limit counter) ──────────────────
    // Per-uid, per-KST-day draft counter. Written ONLY by the callable (admin SDK,
    // bypasses rules). No client ever touches it — deny every client access.
    match /news_generation/{docId} {
      allow read, write: if false;
    }

    // ── ai_usage (AI-1 편집기 AI 일일 상한 카운터) ──────────────────
    // KST 하루치 AI 호출 카운터(문서 id = YYYY-MM-DD). 어드민 콜러블만 admin SDK로
    // 쓴다(룰 우회). 클라이언트가 읽거나 리셋하면 상한이 무의미해지므로 전면 거부.
    match /ai_usage/{docId} {
      allow read, write: if false;
    }

    // ── youtube_quota (LAB-EV-2 유튜브 할당량 카운터) ────────────────
    // 태평양시 하루치 카운터(문서 id = YYYY-MM-DD PT · Google 리셋 기준).
    // 어드민 콜러블만 admin SDK로 쓴다. 클라이언트가 리셋하면 하루 100콜짜리
    // search 버킷이 무방비가 되므로 전면 거부 — 잔여량은 콜러블 드라이런으로 읽는다.
    match /youtube_quota/{docId} {
      allow read, write: if false;
    }

    // ── video_search_cache (LAB-EV-2 검색 결과 캐시) ─────────────────
    // 문서 id = 검색어 해시. 후보 목록 캐시(TTL 7일)로, 클라이언트가 쓰면 아무
    // 영상이나 슬롯에 주입할 수 있게 된다(검수 우회). 전면 거부.
    match /video_search_cache/{docId} {
      allow read, write: if false;
    }

    // ── default deny ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
