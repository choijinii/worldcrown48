{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/AIReportFooter/**",
              "components/Button/**",
              "components/StatusPill/**",
              "components/TournamentCard/**",
              "components/VSBattle/**",
              "ds/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard|Playfair Display Local|Inter|Playfair Display|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Pretendard, Playfair Display Local, Inter, Playfair Display, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIReportFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:timestamp|key|ref|className|style|children)$/]",
        "message": "<AIReportFooter> doesn't accept that prop. Declared props: timestamp."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'gold' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:draft|published|active|closed|completed)$/]",
        "message": "<StatusPill> status must be one of 'draft' | 'published' | 'active' | 'closed' | 'completed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TournamentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|title|contestants|deadline|status|cover|key|ref|className|style|children)$/]",
        "message": "<TournamentCard> doesn't accept that prop. Declared props: category, title, contestants, deadline, status, cover."
      },
      {
        "selector": "JSXOpeningElement[name.name='TournamentCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:K-POP|OTHER)$/]",
        "message": "<TournamentCard> category must be one of 'K-POP' | 'OTHER'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TournamentCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:draft|published|active|closed|completed)$/]",
        "message": "<TournamentCard> status must be one of 'draft' | 'published' | 'active' | 'closed' | 'completed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VSContestant'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|initial|tint|key|ref|className|style|children)$/]",
        "message": "<VSContestant> doesn't accept that prop. Declared props: name, meta, initial, tint."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AIReportFooter": {
        "replaces": []
